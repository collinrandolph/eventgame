    "effects": [ { "learnProp": ["thing", "inspect"] } ], "ticks": 6, "solverAuto": true,
    "label": "Survey {thing}", "text": "{actor} surveys {thing} with a trained eye." },
  { "id": "talk", "params": { "person": { "kind": "person", "from": "here" } },
