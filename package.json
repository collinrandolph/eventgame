{
  "name": "event-kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EVENT puzzle kernel: data-driven world rules, life handoffs, and a solver. No rendering.",
  "scripts": {
    "play": "tsx src/cli/play.ts",
    "check": "tsx src/cli/check.ts",
    "check:full": "tsx src/cli/check.ts --full",
    "viz": "tsx src/cli/viz.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sprites": "tsx src/cli/sprites.ts export",
    "check:sprites": "tsx src/cli/sprites.ts check",
    "env": "tsx src/cli/env.ts",
    "city": "tsx src/cli/city.ts",
    "import-tiles": "tsx src/cli/import-tiles.ts",
    "ideas": "tsx src/cli/ideas.ts",
    "block": "tsx src/cli/block.ts",
    "block3d": "tsx src/cli/block3d.ts",
    "town": "tsx src/cli/town.ts",
    "arena:sprites": "tsx src/cli/variants.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
